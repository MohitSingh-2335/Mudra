# Mudra Environment Configuration
# Required: Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-mudra.us-east-2.aws.neon.tech/neondb?sslmode=require

# Required for Hourly Post-Mortems & LLM Analysis: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.5-flash-lite / gemini-3.8-flash)
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
