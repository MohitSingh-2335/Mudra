# Dockerfile.streamlit - Mudra Interactive Quantitative Dashboard

FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable real-time log flushing
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies (OpenMP for XGBoost/SHAP and curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (leverages Docker layer caching)
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Copy application code, dashboard, and artifacts
COPY config.py .
COPY app.py .
COPY src/ ./src/
COPY artifacts/ ./artifacts/
COPY data/processed/ ./data/processed/

# Security: Run as dedicated non-root user
RUN useradd -m -u 1000 mudrauser && \
    chown -R mudrauser:mudrauser /app
USER mudrauser

# Expose Streamlit port
EXPOSE 8501

# Container health monitoring probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Start Streamlit in headless server mode
CMD ["streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--server.enableCORS=false", \
     "--server.enableXsrfProtection=false"]
